# Long random strings, e.g. `openssl rand -hex 32`
CENTRIFUGO_SECRET=change-me-hmac-secret
CENTRIFUGO_API_KEY=change-me-api-key
# Optional basic-auth password for the panel (any username)
PANEL_PASSWORD=
# Public addresses when not running on localhost
PANEL_ORIGIN=http://localhost:8090
CENTRIFUGO_PUBLIC_WS=ws://localhost:8000/connection/websocket
